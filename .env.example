# OpenArtifact — environment variable reference
# Copy to .env and fill in your values.

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Read/write timeouts in seconds; 0 (default) = unlimited so large uploads are never truncated.
#SERVER_READ_TIMEOUT=0
#SERVER_WRITE_TIMEOUT=0
SERVER_SHUTDOWN_TIMEOUT=30
#SERVER_TLS_ENABLED=false
#SERVER_TLS_CERT=/etc/openartifact/tls/cert.pem
#SERVER_TLS_KEY=/etc/openartifact/tls/key.pem
#API_KEY=your-secret-api-key
#CORS_ORIGINS=https://app.example.com,https://ci.example.com
#OPENARTIFACT_INSTANCE_ID=node-1  # Optional: instance identifier for HA deployments
#OPENARTIFACT_CONFIG=/etc/openartifact/openartifact.yaml  # Optional YAML config file (same as -config)
# Seconds to wait for request headers (slowloris protection)
#SERVER_READ_HEADER_TIMEOUT=10
# Public base URL; required for SSO callbacks behind a proxy
#BASE_URL=https://artifacts.example.com

# Boolean env values use strconv.ParseBool: true/false/1/0/t/f ("yes" is not valid).

# ─── Security ─────────────────────────────────────────────────────────────────
# Allow unauthenticated reads of repositories
#ALLOW_ANONYMOUS_READ=false
# Accept the legacy API_KEY for write endpoints (default true)
#LEGACY_API_KEY_ENABLED=true
#SESSION_DURATION_HOURS=24
# HMAC key for OIDC/SAML login state. REQUIRED for multi-replica or restart-safe
# SSO; a random key is generated at each boot when unset.
#AUTH_HMAC_KEY=CHANGE_ME_long_random_string
# Key (>=16 bytes, AES-256-GCM) used to encrypt stored secrets at rest. Unset = plaintext
# at rest (with a warning); changing the key makes existing ciphertexts unreadable.
#OPENARTIFACT_SECRET_KEY=CHANGE_ME_long_random_string
# Bearer token required to scrape /metrics. /metrics fails closed without it
# unless METRICS_ALLOW_ANONYMOUS=true.
#METRICS_AUTH_TOKEN=
#METRICS_ALLOW_ANONYMOUS=false
# Allow private/loopback webhook and upstream targets (169.254.x metadata is always blocked)
#OPENARTIFACT_ALLOW_PRIVATE_UPSTREAMS=false
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated CIDRs)
#OPENARTIFACT_TRUSTED_PROXIES=10.0.0.0/8
# IP allowlist: comma-separated CIDR blocks (empty = allow all)
#OPENARTIFACT_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# Rate limiting: requests per second per IP (0 = disabled)
#OPENARTIFACT_RATE_LIMIT_RPS=100

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=artifact_repo
# Use "disable" only for local development without TLS.
DB_SSLMODE=require
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=5
#DB_CONN_MAX_LIFETIME_MINUTES=30

# ─── Storage backend ──────────────────────────────────────────────────────────
# Choose "filesystem" (default), "s3", "gcs", "azure", "garage", "seaweedfs" or "oci"
STORAGE_BACKEND=filesystem

# Filesystem storage (used when STORAGE_BACKEND=filesystem)
STORAGE_PATH=/var/lib/artifacts

# S3 / S3-compatible storage (used when STORAGE_BACKEND=s3)
# Required fields:
#STORAGE_BUCKET=openartifact
#STORAGE_REGION=us-east-1

# Optional — leave unset to use the standard AWS credential chain (env vars,
# shared config file, EC2/ECS instance metadata / IAM role).
#STORAGE_ACCESS_KEY=CHANGE_ME
#STORAGE_SECRET_KEY=CHANGE_ME

# Optional — set to override the S3 endpoint (Garage, Ceph, GCS XML API, etc.)
#STORAGE_ENDPOINT=http://garage:3900

# Set to true when using path-style addressing (required for Garage, Ceph)
#STORAGE_S3_FORCE_PATH_STYLE=false

# Presigned URL TTL — clamped to [1m, 1h]; default 5m
#STORAGE_S3_PRESIGN_TTL=5m

# ─── GCS (Google Cloud Storage) ────────────────────────────────────────────
# Uses the S3-compatible XML API
#STORAGE_BACKEND=gcs
#OPENARTIFACT_GCS_BUCKET=my-bucket
#OPENARTIFACT_GCS_HMAC_KEY=your-hmac-access-key
#OPENARTIFACT_GCS_HMAC_SECRET=your-hmac-secret-key

# ─── Azure Blob Storage ────────────────────────────────────────────────────
#STORAGE_BACKEND=azure
#OPENARTIFACT_AZURE_ACCOUNT_NAME=myaccount
#OPENARTIFACT_AZURE_ACCOUNT_KEY=your-base64-encoded-account-key
#OPENARTIFACT_AZURE_CONTAINER_NAME=artifacts

# ─── OCI registry storage ──────────────────────────────────────────────────
#STORAGE_BACKEND=oci
#STORAGE_OCI_USERNAME=user
#STORAGE_OCI_PASSWORD=CHANGE_ME
# Allow plain HTTP to the registry (dev/testing only)
#STORAGE_OCI_INSECURE=false

# ─── Backups ───────────────────────────────────────────────────────────────
#OPENARTIFACT_BACKUP_DIR=/var/lib/openartifact/backups

# ─── Garage example (local development; see https://garagehq.deuxfleurs.fr) ───
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT=http://localhost:3900
# STORAGE_BUCKET=openartifact
# STORAGE_REGION=garage
# STORAGE_ACCESS_KEY=GK...        # from `garage key create`
# STORAGE_SECRET_KEY=CHANGE_ME
# STORAGE_S3_FORCE_PATH_STYLE=true

# ─── GPG Signing ──────────────────────────────────────────────────────────────
GPG_ENABLED=false
#GPG_KEY_PATH=/etc/openartifact/gpg/private.key
#GPG_PASSPHRASE=your-passphrase
#GPG_AUTO_GENERATE=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ─── SAML Service Provider (SP) Configuration ─────────────────────────────────
# For persistent SAML authentication across server restarts, configure the SP keypair.
# If not set, an ephemeral keypair is generated on each startup (requires re-registration with IdP).
#
# Generate a self-signed certificate and key with:
#   openssl req -x509 -newkey rsa:2048 -keyout sp.key -out sp.crt -days 3650 -nodes -subj "/CN=openartifact-sp"
#
# Then set these environment variables:
#   OPENARTIFACT_SAML_SP_CERT=$(cat sp.crt)
#   OPENARTIFACT_SAML_SP_KEY=$(cat sp.key)
#
#OPENARTIFACT_SAML_SP_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
#OPENARTIFACT_SAML_SP_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ─── Migrations ───────────────────────────────────────────────────────────────
# Set to false to disable automatic migration on startup
MIGRATE_ON_START=true

# ─── AI Analysis ──────────────────────────────────────────────────────────────
# Enable AI-powered artifact analysis (metadata tagging, license check, security notes)
AI_ENABLED=false

# Provider: "openai" | "azure" | "ollama" (any OpenAI-compatible endpoint)
AI_PROVIDER=openai

# API key (required for openai/azure; leave empty for local ollama)
#AI_API_KEY=sk-...

# Base URL override — set for Azure OpenAI, Ollama, or other compatible endpoints
# Azure example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# Ollama example: http://localhost:11434/v1
#AI_BASE_URL=

# Model to use (must be available on the configured provider)
AI_MODEL=gpt-4o-mini

# Max completion tokens per analysis request
AI_MAX_TOKENS=1024

# HTTP timeout in seconds for AI API calls
AI_TIMEOUT_SECS=30

# Optional: override the built-in system prompt
#AI_SYSTEM_PROMPT=

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Expose an MCP (Model Context Protocol) server for AI agent integration
MCP_ENABLED=false

# Transport: only "http" is supported (the endpoint is embedded in the main
# server and requires `Authorization: Bearer <TOKEN>`). "stdio" is rejected.
MCP_TRANSPORT=http

# Mount path of the MCP HTTP endpoint
MCP_HTTP_PATH=/mcp
