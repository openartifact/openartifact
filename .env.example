# OpenArtifact — environment variable reference
# Copy to .env and fill in your values.

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Read/write timeouts in seconds; 0 (default) = unlimited so large uploads are never truncated.
#SERVER_READ_TIMEOUT=0
#SERVER_WRITE_TIMEOUT=0
SERVER_SHUTDOWN_TIMEOUT=30
#SERVER_TLS_ENABLED=false
#SERVER_TLS_CERT=/etc/openartifact/tls/cert.pem
#SERVER_TLS_KEY=/etc/openartifact/tls/key.pem
#API_KEY=your-secret-api-key
#CORS_ORIGINS=https://app.example.com,https://ci.example.com
#OPENARTIFACT_INSTANCE_ID=node-1  # Optional: instance identifier for HA deployments
#OPENARTIFACT_CONFIG=/etc/openartifact/openartifact.yaml  # Optional YAML config file (same as -config)
# Seconds to wait for request headers (slowloris protection)
#SERVER_READ_HEADER_TIMEOUT=10
# Maximum request body in bytes for every endpoint (default 16 GiB; 0 = unlimited).
# Per-format limits (e.g. pypi, npm, maven) apply below this.
#SERVER_MAX_BODY_BYTES=17179869184
# Public base URL; required for SSO callbacks behind a proxy
#BASE_URL=https://artifacts.example.com

# Boolean env values use strconv.ParseBool: true/false/1/0/t/f ("yes" is not valid).

# ─── Security ─────────────────────────────────────────────────────────────────
# Allow unauthenticated reads of repositories
#ALLOW_ANONYMOUS_READ=false
# Accept the deprecated shared API_KEY (full admin; default false)
#LEGACY_API_KEY_ENABLED=false
#SESSION_DURATION_HOURS=24
# First admin (only applied to an empty instance; see docs/getting-started/installation.md).
# File holding the initial admin password (trailing newline trimmed). Preferred over
# OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD. Unset: a random password is generated and
# printed once to stderr.
#OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# The password itself (compose convenience; prefer the _FILE form).
#OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD=
# Force a password change at the first login of a supplied password (default false).
#OPENARTIFACT_BOOTSTRAP_FORCE_PASSWORD_CHANGE=false
# File holding an admin API token secret: oa_pat_ + 32..128 chars of A-Za-z0-9_-
# (e.g. oa_pat_$(openssl rand -hex 32)); created as the access token "bootstrap".
#OPENARTIFACT_BOOTSTRAP_ADMIN_TOKEN_FILE=
# Lifetime of the bootstrap token (e.g. 720h); 0 = no expiry.
#OPENARTIFACT_BOOTSTRAP_ADMIN_TOKEN_TTL=0
# How long a generated (printed) admin password is accepted at login; 0 = never.
#OPENARTIFACT_BOOTSTRAP_GENERATED_PASSWORD_TTL=24h
# HMAC key for OIDC/SAML login state. Optional: when unset a random key is
# generated once and persisted in system_settings (shared by all replicas).
# When set, this value wins over the stored one.
#AUTH_HMAC_KEY=CHANGE_ME_long_random_string
# Key (>=16 bytes, AES-256-GCM) used to encrypt stored secrets at rest. Unset = plaintext
# at rest (with a warning); changing the key makes existing ciphertexts unreadable.
#OPENARTIFACT_SECRET_KEY=CHANGE_ME_long_random_string
# Bearer token required to scrape /metrics. /metrics fails closed without it
# unless METRICS_ALLOW_ANONYMOUS=true.
#METRICS_AUTH_TOKEN=
#METRICS_ALLOW_ANONYMOUS=false
# Allow private/loopback webhook and upstream targets (169.254.x metadata is always blocked)
#OPENARTIFACT_ALLOW_PRIVATE_UPSTREAMS=false
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated CIDRs)
#OPENARTIFACT_TRUSTED_PROXIES=10.0.0.0/8
# IP allowlist: comma-separated CIDR blocks (empty = allow all)
#OPENARTIFACT_IP_ALLOWLIST=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# Rate limiting: requests per second per IP (0 = disabled)
#OPENARTIFACT_RATE_LIMIT_RPS=100

# Go runtime profiler (pprof) under /api/v1/admin/pprof/ — admin credentials
# required. Off by default; enable only while diagnosing performance.
#OPENARTIFACT_PPROF_ENABLED=false

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=artifact_repo
# Use "disable" only for local development without TLS.
DB_SSLMODE=require
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=5
#DB_CONN_MAX_LIFETIME_MINUTES=30
# How long startup keeps retrying the initial database connection (capped
# exponential backoff, each wait logged) before exiting. 0 fails immediately.
#DB_CONNECT_TIMEOUT=60s
# Extra libpq connection parameters as comma-separated key=value pairs.
#DB_OPTIONS=connect_timeout=5,application_name=openartifact
# How long per-request auth lookups (token, user, groups, permissions, repo by
# name) are cached in memory, in milliseconds. Changes made through this
# instance apply immediately; other replicas see them after at most this long.
# 0 disables the cache.
#DB_AUTH_CACHE_TTL_MS=2000

# ─── Storage backend ──────────────────────────────────────────────────────────
# Choose "filesystem" (default), "s3", "gcs", "azure", "garage", "seaweedfs" or "oci"
STORAGE_BACKEND=filesystem
# STORAGE_TYPE is accepted as an alias; STORAGE_BACKEND wins when both are set.
#STORAGE_TYPE=filesystem
# Free-form backend options as comma-separated key=value pairs (no built-in backend reads any yet).
#STORAGE_OPTIONS=

# Filesystem storage (used when STORAGE_BACKEND=filesystem)
STORAGE_PATH=/var/lib/artifacts

# S3 / S3-compatible storage (used when STORAGE_BACKEND=s3)
# Required fields:
#STORAGE_BUCKET=openartifact
#STORAGE_REGION=us-east-1

# Optional — leave unset to use the standard AWS credential chain (env vars,
# shared config file, EC2/ECS instance metadata / IAM role).
#STORAGE_ACCESS_KEY=CHANGE_ME
#STORAGE_SECRET_KEY=CHANGE_ME

# Optional — set to override the S3 endpoint (Garage, Ceph, GCS XML API, etc.)
#STORAGE_ENDPOINT=http://garage:3900

# Set to true when using path-style addressing (required for Garage, Ceph)
#STORAGE_S3_FORCE_PATH_STYLE=false

# Presigned URL TTL — clamped to [1m, 1h]; default 5m
#STORAGE_S3_PRESIGN_TTL=5m

# Direct downloads (s3 / gcs only): answer blob downloads with a 307 redirect
# to a presigned URL instead of streaming through the server. Off by default.
#STORAGE_PRESIGN_DOWNLOADS=false
# Blobs smaller than this many bytes are streamed (default 1 MiB; 0 = redirect all)
#STORAGE_PRESIGN_MIN_SIZE=1048576
# Public base URL used ONLY for signing; set when STORAGE_ENDPOINT is internal
# and not reachable by clients (e.g. http://minio.svc:9000 -> https://s3.example.com)
#STORAGE_PRESIGN_ENDPOINT=https://s3.example.com
# Lifetime of presigned upload URLs — clamped to [1m, 12h]; default 30m
#STORAGE_PRESIGN_UPLOAD_TTL=30m
# Max outstanding (not completed, not expired) presigned uploads per user;
# default 20, 0 = unlimited (429 + Retry-After when exceeded)
#STORAGE_PRESIGN_MAX_PENDING_UPLOADS=20

# ─── GCS (Google Cloud Storage) ────────────────────────────────────────────
# Uses the S3-compatible XML API
#STORAGE_BACKEND=gcs
#OPENARTIFACT_GCS_BUCKET=my-bucket
#OPENARTIFACT_GCS_HMAC_KEY=your-hmac-access-key
#OPENARTIFACT_GCS_HMAC_SECRET=your-hmac-secret-key

# ─── Azure Blob Storage ────────────────────────────────────────────────────
#STORAGE_BACKEND=azure
#OPENARTIFACT_AZURE_ACCOUNT_NAME=myaccount
#OPENARTIFACT_AZURE_ACCOUNT_KEY=your-base64-encoded-account-key
#OPENARTIFACT_AZURE_CONTAINER_NAME=artifacts
# Blob service URL for Azurite or a sovereign cloud; empty = https://<account>.blob.core.windows.net
#OPENARTIFACT_AZURE_ENDPOINT=http://azurite:10000/devstoreaccount1

# ─── OCI registry storage ──────────────────────────────────────────────────
#STORAGE_BACKEND=oci
#STORAGE_OCI_USERNAME=user
#STORAGE_OCI_PASSWORD=CHANGE_ME
# Spool directory for server-relayed presigned uploads (oci only; filesystem uses <STORAGE_PATH>/staging).
# Default: <system temp dir>/openartifact-staging
#STORAGE_STAGING_PATH=/var/lib/artifacts-staging
# Allow plain HTTP to the registry (dev/testing only)
#STORAGE_OCI_INSECURE=false

# Blob replication: an async second copy of every blob on another backend, with
# read fallback and verify/repair (docs/operations/replication.md). Active when
# the replica type is set. The replica takes the same backend variables as the
# primary under the OPENARTIFACT_STORAGE_REPLICA_ prefix.
#OPENARTIFACT_STORAGE_REPLICA_TYPE=s3
#OPENARTIFACT_STORAGE_REPLICA_ENDPOINT=http://garage:3900
#OPENARTIFACT_STORAGE_REPLICA_BUCKET=openartifact-replica
#OPENARTIFACT_STORAGE_REPLICA_REGION=garage
#OPENARTIFACT_STORAGE_REPLICA_ACCESS_KEY=CHANGE_ME
#OPENARTIFACT_STORAGE_REPLICA_SECRET_KEY=CHANGE_ME
#OPENARTIFACT_STORAGE_REPLICA_FORCE_PATH_STYLE=true
# Filesystem replica instead: TYPE=filesystem and
#OPENARTIFACT_STORAGE_REPLICA_PATH=/mnt/replica/artifacts
# Free-form backend options, comma-separated key=value pairs.
#OPENARTIFACT_STORAGE_REPLICA_OPTIONS=key=value,key=value
# GCS replica (S3-compatible XML API):
#OPENARTIFACT_STORAGE_REPLICA_GCS_BUCKET=my-replica-bucket
#OPENARTIFACT_STORAGE_REPLICA_GCS_HMAC_KEY=CHANGE_ME
#OPENARTIFACT_STORAGE_REPLICA_GCS_HMAC_SECRET=CHANGE_ME
# Azure Blob replica (AZURE_ENDPOINT: Azurite or a sovereign cloud; empty = the public cloud):
#OPENARTIFACT_STORAGE_REPLICA_AZURE_ACCOUNT_NAME=myaccount
#OPENARTIFACT_STORAGE_REPLICA_AZURE_ACCOUNT_KEY=CHANGE_ME
#OPENARTIFACT_STORAGE_REPLICA_AZURE_CONTAINER_NAME=artifacts-replica
#OPENARTIFACT_STORAGE_REPLICA_AZURE_ENDPOINT=http://azurite:10000/devstoreaccount1
# OCI registry replica (OCI_INSECURE allows plain HTTP, dev/testing only):
#OPENARTIFACT_STORAGE_REPLICA_OCI_USERNAME=user
#OPENARTIFACT_STORAGE_REPLICA_OCI_PASSWORD=CHANGE_ME
#OPENARTIFACT_STORAGE_REPLICA_OCI_INSECURE=false
# Reads fall back to the replica: notfound (primary says missing) | error (also
# when the primary fails) | off.
#OPENARTIFACT_STORAGE_REPLICA_READ_FALLBACK=notfound
# Queue worker: pause between passes, operations claimed per pass, blobs copied at once.
#OPENARTIFACT_STORAGE_REPLICA_INTERVAL=5s
#OPENARTIFACT_STORAGE_REPLICA_BATCH=100
#OPENARTIFACT_STORAGE_REPLICA_CONCURRENCY=4
# Pause between full verify passes (0 = only when an admin requests one) and
# whether they hash the bytes of both copies (expensive).
#OPENARTIFACT_STORAGE_REPLICA_VERIFY_INTERVAL=24h
#OPENARTIFACT_STORAGE_REPLICA_VERIFY_DEEP=false
# Longest retry delay of a failing replication operation.
#OPENARTIFACT_STORAGE_REPLICA_MAX_BACKOFF=1h

# ─── Backups ───────────────────────────────────────────────────────────────
#OPENARTIFACT_BACKUP_DIR=/var/lib/openartifact/backups
# How long a running backup's lease lasts without a heartbeat (a crashed backup
# stops holding blob deletions after this time). Must be positive.
#OPENARTIFACT_BACKUP_LEASE_TTL=5m

# ─── Deferred blob deletion ────────────────────────────────────────────────
# Bytes of deleted blobs are removed by a sweeper after this grace period and
# only when no running backup can still need them. 0 = no grace.
#OPENARTIFACT_BLOB_DELETION_GRACE=24h
# Pause between sweeper passes (0 = sweeper off on this replica).
#OPENARTIFACT_BLOB_DELETION_SWEEP_INTERVAL=1m
# Deletions claimed per pass (must be positive).
#OPENARTIFACT_BLOB_DELETION_SWEEP_BATCH=200

# ─── Garage example (local development; see https://garagehq.deuxfleurs.fr) ───
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT=http://localhost:3900
# STORAGE_BUCKET=openartifact
# STORAGE_REGION=garage
# STORAGE_ACCESS_KEY=GK...        # from `garage key create`
# STORAGE_SECRET_KEY=CHANGE_ME
# STORAGE_S3_FORCE_PATH_STYLE=true

# ─── GPG Signing ──────────────────────────────────────────────────────────────
GPG_ENABLED=false
#GPG_KEY_PATH=/etc/openartifact/gpg/private.key
#GPG_PASSPHRASE=your-passphrase
# Generate a global signing key at startup when no key exists (needs OPENARTIFACT_SECRET_KEY).
#GPG_AUTO_GENERATE=false

# ─── SBOM / VEX attestations ──────────────────────────────────────────────────
# Signing key (unencrypted PKCS#8 or SEC1 PEM, ECDSA or Ed25519) for
# ?attest=true downloads. Unset: a P-256 key is generated and stored encrypted.
#ATTESTATION_KEY_PATH=/etc/openartifact/attestation/key.pem

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ─── OpenTelemetry (off by default) ───────────────────────────────────────────
# Distributed traces over OTLP; see docs/operations/monitoring.md#opentelemetry-tracing.
# Telemetry is enabled only by this switch (or telemetry.otlp.enabled in YAML):
# setting an OTEL_* endpoint alone does not turn it on. OTEL_SDK_DISABLED=true
# forces it off.
# OPENARTIFACT_OTLP_ENABLED=false
# The standard OpenTelemetry variables are honored and override the YAML file:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317   # host:port or http(s) URL
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc                         # grpc | http (alias http/protobuf)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20TOKEN  # k=v,k2=v2, values percent-decoded
# OTEL_EXPORTER_OTLP_INSECURE=false                        # plaintext to the collector (implied by http://)
# OTEL_SERVICE_NAME=openartifact
# OTEL_TRACES_SAMPLER_ARG=1.0                              # fraction of new traces recorded, 0..1
# OTEL_METRICS_EXPORTER=none                               # otlp = also export the Prometheus registry over OTLP
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod     # extra resource attributes
# OTEL_SDK_DISABLED=false                                  # true forces telemetry off, overriding every other switch

# ─── SAML Service Provider (SP) Configuration ─────────────────────────────────
# Optional. If not set, a self-signed SP keypair is generated once and persisted
# encrypted in system_settings (shared by all replicas; unencrypted when
# OPENARTIFACT_SECRET_KEY is unset). Regenerating it means re-registering the SP
# certificate at the IdP. Set the pair to manage the keypair yourself.
#
# Generate a self-signed certificate and key with:
#   openssl req -x509 -newkey rsa:2048 -keyout sp.key -out sp.crt -days 3650 -nodes -subj "/CN=openartifact-sp"
#
# Then set these environment variables:
#   OPENARTIFACT_SAML_SP_CERT=$(cat sp.crt)
#   OPENARTIFACT_SAML_SP_KEY=$(cat sp.key)
#
#OPENARTIFACT_SAML_SP_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
#OPENARTIFACT_SAML_SP_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ─── Migrations ───────────────────────────────────────────────────────────────
# Set to false to disable automatic migration on startup
MIGRATE_ON_START=true

# ─── Projects ─────────────────────────────────────────────────────────────────
# Let any authenticated user create a project and become its owner (default off: only
# global admins create projects). Administrators can change this at runtime in the UI
# (Admin > Projects); a saved value takes precedence over this default.
OPENARTIFACT_PROJECTS_SELF_CREATE=false

# ─── AI Analysis ──────────────────────────────────────────────────────────────
# Enable AI-powered artifact analysis (metadata tagging, license check, security notes)
AI_ENABLED=false

# Analyse every uploaded package automatically (off: analyses start only when requested
# through the UI, API or MCP). Needs AI_ENABLED=true; the server reads the manifest itself.
AI_AUTO_ANALYZE=false

# Provider: "openai" | "azure" | "ollama" | "custom" (custom = any OpenAI-compatible endpoint, needs AI_BASE_URL)
AI_PROVIDER=openai

# API key (required for openai/azure; leave empty for local ollama)
#AI_API_KEY=sk-...

# Base URL override — set for Azure OpenAI, Ollama, or other compatible endpoints
# Azure example: https://<resource>.openai.azure.com/openai/deployments/<deployment>
# Ollama example: http://localhost:11434/v1
#AI_BASE_URL=

# Model to use (must be available on the configured provider)
AI_MODEL=gpt-4o-mini

# Max completion tokens per analysis request
AI_MAX_TOKENS=1024

# HTTP timeout in seconds for AI API calls
AI_TIMEOUT_SECS=30

# Optional: override the built-in system prompt
#AI_SYSTEM_PROMPT=

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Expose an MCP (Model Context Protocol) server for AI agent integration
MCP_ENABLED=false

# Transport: only "http" is supported (the endpoint is embedded in the main
# server and requires `Authorization: Bearer <TOKEN>`). "stdio" is rejected.
MCP_TRANSPORT=http

# Mount path of the MCP HTTP endpoint
MCP_HTTP_PATH=/mcp

# Browser origins accepted in the Origin header of MCP requests, besides the
# BASE_URL origin (comma-separated, scheme://host[:port]). Any other Origin gets
# 403; clients that send no Origin (CLIs, desktop agents) are unaffected.
#MCP_ALLOWED_ORIGINS=https://agents.example.com

# Max size of one MCP request body in bytes (default 1 MiB)
#MCP_MAX_BODY_BYTES=1048576

# MCP requests allowed per authenticated principal per minute (default 600, 0 = unlimited)
#MCP_RATE_LIMIT_PER_MINUTE=600

# trigger_ai_analysis calls allowed per principal per minute; each can cost an
# LLM call (default 10, 0 = unlimited)
#MCP_AI_TRIGGER_PER_MINUTE=10

# ─── Background workers ───────────────────────────────────────────────────────
# Max metadata regenerations (npm, maven, deb, rpm together) running at once.
# Each pins up to two database connections while it runs, so keep this well
# below DB_MAX_OPEN_CONNS. Bursts of uploads are coalesced per package/repo.
#OPENARTIFACT_METADATA_REGEN_CONCURRENCY=4
# Docker registry garbage collection: untagged manifests older than the grace
# period are deleted together with the blobs only they referenced. The interval
# is the pause between passes over all docker repositories (Go duration; 0
# disables the schedule, admins can still run it via the API). Digest-pinned
# references to an untagged manifest break once it is collected.
#OPENARTIFACT_DOCKER_GC_INTERVAL=1h
#OPENARTIFACT_DOCKER_GC_GRACE_PERIOD=24h
# Docker proxy repositories: manifests and blobs addressed by digest never change,
# so they are cached until they have not been pulled for this long (Go duration;
# a pull in the second half of the period renews it). The proxy cache worker then
# evicts them and the next pull fetches them from the upstream again. 0 keeps them
# until an admin purge or the repository is removed.
#OPENARTIFACT_PROXY_DOCKER_DIGEST_TTL=720h
# Abandoned docker blob uploads (a cancelled or crashed `docker push`) idle for
# longer than the TTL are deleted with their staged file (Go duration; 0
# disables the sweeper). The directory holds in-progress uploads and must be
# writable and large enough for your biggest layer.
#OPENARTIFACT_DOCKER_UPLOAD_TTL=24h
#OPENARTIFACT_DOCKER_UPLOAD_DIR=/tmp/openartifact/docker-uploads
# Days finished (success/failed) webhook delivery records are kept before the
# hourly purge deletes them; 0 keeps them forever.
#OPENARTIFACT_WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Audit log retention: entries older than this many days are deleted in paced
# batches, one replica at a time; 0 keeps the audit log forever. Nothing is
# exported first: archive with `oa audit export` beforehand. The interval is the
# pause between passes (Go duration) and the batch size the rows one delete
# statement removes. See docs/operations/audit-retention.md.
#OPENARTIFACT_AUDIT_RETENTION_DAYS=0
#OPENARTIFACT_AUDIT_PURGE_INTERVAL=1h
#OPENARTIFACT_AUDIT_PURGE_BATCH_SIZE=5000
# Trash (soft delete): deleted artifacts, versions and repositories stay
# restorable for this many days before the purge worker removes them for good.
# Repositories can override it (trash_retention_days). 0 turns the trash off:
# deletes are immediate and permanent. Soft-deleted bytes keep counting against
# quotas until purged. See docs/operations/trash.md.
#OPENARTIFACT_TRASH_RETENTION=7
# Pause between purge passes (Go duration; 0 disables the schedule, admins can
# still purge by hand).
#OPENARTIFACT_TRASH_PURGE_INTERVAL=15m
# Root of the published documentation the web UI links to (versioned for
# release builds, latest for development builds). Point it at a mirror for
# air-gapped installs; empty hides every documentation link.
#OPENARTIFACT_DOCS_BASE_URL=https://openartifact.github.io/
# White-label branding (docs/operations/branding.md). Administrators can
# override every value at runtime; a runtime value wins. Logos and the favicon
# are file paths to a PNG or SVG (max 512 KiB). The "Powered by OpenArtifact"
# attribution and the source link always stay visible (AGPL-3.0 section 13).
#OPENARTIFACT_BRANDING_PRODUCT_NAME=Acme Artifacts
#OPENARTIFACT_BRANDING_LOGO_LIGHT=/etc/openartifact/brand/logo-light.svg
#OPENARTIFACT_BRANDING_LOGO_DARK=/etc/openartifact/brand/logo-dark.svg
#OPENARTIFACT_BRANDING_FAVICON=/etc/openartifact/brand/favicon.png
#OPENARTIFACT_BRANDING_PRIMARY_COLOR=#0f766e
#OPENARTIFACT_BRANDING_LOGIN_MESSAGE=Internal use only.
#OPENARTIFACT_BRANDING_SUPPORT_URL=https://support.example.com
#OPENARTIFACT_BRANDING_SOURCE_URL=https://github.com/openartifact/openartifact
# Federated repositories (docs/operations/federation.md). Master switch of the
# pull workers and of the /federation/v1 peer endpoints; repositories are
# federated individually.
#OPENARTIFACT_FEDERATION_ENABLED=false
# Pause between pulls of one peer, entries fetched per request, retry backoff
# ceiling, per-request timeout, and how long delete tombstones are kept.
#OPENARTIFACT_FEDERATION_POLL_INTERVAL=30s
#OPENARTIFACT_FEDERATION_BATCH_SIZE=200
#OPENARTIFACT_FEDERATION_MAX_BACKOFF=15m
#OPENARTIFACT_FEDERATION_REQUEST_TIMEOUT=30s
#OPENARTIFACT_FEDERATION_TOMBSTONE_RETENTION=720h
# Storage tiers and lifecycle policies (docs/operations/storage-tiering.md).
# Tiers and policies are managed in the admin UI/API; with only the primary
# store configured none of the following does anything.
# Run the background mover that relocates blobs between tiers per policy.
#OPENARTIFACT_TIERING_ENABLED=true
# Pause between mover passes (Go duration; 0 disables the schedule, admins can
# still run a pass by hand).
#OPENARTIFACT_TIERING_INTERVAL=5m
# Most blobs one pass moves, and how many are copied at once.
#OPENARTIFACT_TIERING_BATCH=200
#OPENARTIFACT_TIERING_CONCURRENCY=2
# Cap on the mover's total copy bandwidth in bytes per second (0 = unlimited).
#OPENARTIFACT_TIERING_MAX_BYTES_PER_SECOND=67108864
# Re-read each copied blob from the target tier and compare its sha256 before
# the placement flips (on top of the size check).
#OPENARTIFACT_TIERING_VERIFY_READBACK=true
# How often recorded downloads (for "idle for N days" policies and promote on
# read) are written to the database, and how often each replica reloads tiers.
#OPENARTIFACT_TIERING_ACCESS_FLUSH_INTERVAL=30s
#OPENARTIFACT_TIERING_REFRESH_INTERVAL=30s

# Disaster-recovery row journal (docs/operations/rebuild-from-storage.md):
# mirrors package metadata as small sidecar blobs in the blob store so
# `openartifact rebuild` can re-index an empty database from storage alone.
#OPENARTIFACT_RECOVERY_JOURNAL_ENABLED=true
# Pause between worker passes draining the changed-row queue, rows claimed per
# step and sidecar blobs written at once.
#OPENARTIFACT_RECOVERY_JOURNAL_INTERVAL=10s
#OPENARTIFACT_RECOVERY_JOURNAL_BATCH=200
#OPENARTIFACT_RECOVERY_JOURNAL_CONCURRENCY=4
# How often every journaled table is re-checked for rows without a sidecar
# (backfill after an upgrade or a pg_restore) and sidecars of deleted rows.
#OPENARTIFACT_RECOVERY_JOURNAL_RECONCILE_INTERVAL=24h

# Trivy and grype vulnerability scanners (docs/security/scanning.md). They are
# separate binaries on PATH (or at the paths below); the databases are
# downloaded in the background into the cache directory, scans never download.
# Absolute directory for the scanner databases (default: <user cache dir>/openartifact/scanners).
#OPENARTIFACT_SCANNER_CACHE_DIR=/var/cache/openartifact/scanners
# Database refresh interval (Go duration, at least 1h; 0 downloads once and stops).
#OPENARTIFACT_SCANNER_UPDATE_INTERVAL=6h
# Never download databases; they must already be in the cache directory.
#OPENARTIFACT_SCANNER_OFFLINE=false
# Command name or absolute path of the binaries (default: trivy / grype on PATH).
#OPENARTIFACT_TRIVY_PATH=/usr/local/bin/trivy
#OPENARTIFACT_GRYPE_PATH=/usr/local/bin/grype
# Runtime install: "auto" downloads the pinned, sha256-verified release into
# <cache dir>/bin when no path is set and the binary is not on PATH (default none).
# The archives come from the https origin below (github.com, or a mirror that
# serves GitHub's /<owner>/<repo>/releases/download/<tag>/<file> paths).
#OPENARTIFACT_TRIVY_INSTALL=none
#OPENARTIFACT_GRYPE_INSTALL=none
#OPENARTIFACT_SCANNER_DOWNLOAD_BASE_URL=https://github.com
# Mirrors for air-gapped or rate-limited environments: an OCI repository for
# trivy-db (and optionally trivy-java-db; empty skips the Java database), and
# the listing.json URL of a grype database mirror.
#OPENARTIFACT_TRIVY_DB_REPOSITORY=registry.example.com/trivy-db
#OPENARTIFACT_TRIVY_JAVA_DB_REPOSITORY=registry.example.com/trivy-java-db
#OPENARTIFACT_GRYPE_DB_URL=https://mirror.example.com/grype/databases/listing.json
