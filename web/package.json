{
  "name": "openartifact-web",
  "version": "0.25.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run i18n:check && vite build && bun scripts/precompress.js",
    "build:demo": "bun run i18n:check && vite build --mode demo",
    "i18n:check": "bun scripts/i18n-check.ts",
    "i18n:missing": "bun scripts/i18n-missing.ts",
    "i18n:apply": "bun scripts/i18n-apply.ts",
    "dup": "jscpd --config .jscpd.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.sw.json && tsc -p e2e/tsconfig.json",
    "e2e": "cd e2e && bun test ./specs/*.e2e.ts",
    "monkey": "cd e2e && bun test ./monkey.e2e.ts",
    "e2e:chromium": "cd e2e && bun test ./chromium/*.chromium.ts",
    "e2e:visual:update": "cd e2e && UPDATE_SNAPSHOTS=1 bun test ./chromium/visual.chromium.ts",
    "preview": "vite preview",
    "test": "bun test",
    "generate-api": "openapi-ts --input ../internal/api/openapi.json --output src/api/generated --plugins @hey-api/typescript"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/browser-instrumentation": "0.12.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@vueuse/core": "^15.1.0",
    "pinia": "^4.1.0",
    "simple-icons": "^16.38.1",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "1.4.5",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "4.14.1",
    "fast-check": "4.11.0",
    "jscpd": "5.4.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.19.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
