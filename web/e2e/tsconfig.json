// Type-checks the Playwright suites (they run in Node, not in the SPA bundle).
// Not included by the root tsconfig.json, which only covers src/.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../playwright.config.ts", "../playwright.monkey.config.ts"]
}
