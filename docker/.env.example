# docker/.env — credentials for `docker compose -f docker/docker-compose.yml up`
# and for `make docker-run` (via --env-file).
#
# Copy this file to docker/.env (gitignored) and fill in real values:
#   cp docker/.env.example docker/.env
#
# docker-compose.yml substitutes ${POSTGRES_*} into both the postgres
# container and the openartifact app container (as DB_USER/DB_PASSWORD/DB_NAME).

POSTGRES_USER=postgres
# Generate a password: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=artifact_repo

# ─── Application secrets (passed through by docker-compose.yml) ───────────────
# Encrypts upstream passwords, webhook secrets and other stored credentials at
# rest; empty stores them in plaintext. Generate once with `openssl rand -hex 32`
# and never change it afterwards (and use the same key when restoring a backup).
OPENARTIFACT_SECRET_KEY=
# Signs OIDC/SAML login state. Optional: empty generates a random key once and
# persists it in the database (shared by replicas). To manage it: `openssl rand -hex 32`.
AUTH_HMAC_KEY=
# First admin (optional; only applied to an empty database). Empty: a random
# password is generated and printed once to the container's stderr, valid for
# 24h. The plain value is a convenience; for anything shared prefer a file:
# mount it into the container and set OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD_FILE
# (see docs/getting-started/installation.md#first-login).
OPENARTIFACT_BOOTSTRAP_ADMIN_PASSWORD=
# Public URL used for SSO callbacks and links, e.g. https://artifacts.example.com
BASE_URL=

# Runtime base image of the app container: "dhi" (Docker Hardened Images,
# needs `docker login dhi.io`) or "distroless" (anonymous pull). Uncomment the
# second line if you have no dhi.io access.
#OPENARTIFACT_RUNTIME=distroless

# Host address and port of the published UI/API (container port stays 8080).
# Change the port to run several compose projects side by side
# (`docker compose -p <name> ...`); BASE_URL should then match.
#OPENARTIFACT_BIND=127.0.0.1
#OPENARTIFACT_PORT=8080

# Vulnerability scanners to bundle into the app image: none (default), trivy,
# grype or all. Rebuild after changing it (`docker compose build openartifact`).
# The databases are downloaded in the background after start; see
# docs/security/scanning.md for egress, offline and mirror settings.
#OPENARTIFACT_SCANNERS=trivy
# Alternative to bundling: let the server download the pinned, checksum-verified
# release into the scanner_cache volume at runtime (none or auto), from
# github.com or a mirror that serves GitHub's release paths (https only).
#OPENARTIFACT_TRIVY_INSTALL=auto
#OPENARTIFACT_GRYPE_INSTALL=auto
#OPENARTIFACT_SCANNER_DOWNLOAD_BASE_URL=https://mirror.example.com/github
# Optional, passed to the app container: no downloads (copy the databases into
# the scanner_cache volume yourself), refresh interval, and database mirrors.
#OPENARTIFACT_SCANNER_OFFLINE=false
#OPENARTIFACT_SCANNER_UPDATE_INTERVAL=6h
#OPENARTIFACT_TRIVY_DB_REPOSITORY=registry.example.com/trivy-db
#OPENARTIFACT_GRYPE_DB_URL=https://mirror.example.com/grype/databases/listing.json

# ─── Standalone `make docker-run` (no bundled postgres container) ─────────────
# Only needed if you run the app container directly against an external
# Postgres instance instead of via `docker compose up`.
DB_DRIVER=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=artifact_repo
# Require TLS when connecting to an external Postgres instance.
DB_SSLMODE=require
