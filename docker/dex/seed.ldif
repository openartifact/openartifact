# Demo directory for the `dex` compose profile and the Dex integration test
# (tests/integration/dex_sso_integration_test.go). Throwaway credentials: never
# reuse them anywhere real.
#
#   alice / alice-pass   member of artifact-admins and developers
#   bob   / bob-pass     member of developers only
#
# Loaded by the osixia/openldap bootstrap into dc=example,dc=org.

dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice Admin
sn: Admin
givenName: Alice
mail: alice@example.org
userPassword: alice-pass

dn: uid=bob,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: bob
cn: Bob Developer
sn: Developer
givenName: Bob
mail: bob@example.org
userPassword: bob-pass

dn: cn=artifact-admins,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: artifact-admins
member: uid=alice,ou=people,dc=example,dc=org

dn: cn=developers,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: developers
member: uid=alice,ou=people,dc=example,dc=org
member: uid=bob,ou=people,dc=example,dc=org
