[Unit]
Description=OpenArtifact artifact repository server
Documentation=https://openartifact.github.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openartifact
Group=openartifact
# OPENARTIFACT_SECRET_KEY (generated by the package on first install) and any
# other environment override of the config.
EnvironmentFile=-/etc/openartifact/openartifact.env
ExecStart=/usr/bin/openartifact -config /etc/openartifact/openartifact.yaml
# Fails fast with a clear message while the config is still the shipped example
# (the server refuses to start while database.password is CHANGE_ME).
ExecStartPre=/usr/bin/openartifact verify /etc/openartifact/openartifact.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

# Mild hardening; state and backups stay writable under /var/lib (storage.* in
# the config). Operators can override anything with a systemd drop-in.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
