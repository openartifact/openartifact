# Compiled binaries at the repo root (anchored so cmd/server/ etc. are not matched)
/server
/oa
/openartifact
/bin/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage.html
coverage.out
coverage.txt

# Logs / scratch
*.log
tmp/
.tmp/
# bench/run.sh output (contains an access token)
/bench-out/

# Environment
.env
.env.local
.envrc
web/.env*.local

# Web (frontend) build & tooling
web/node_modules/
web/.vite/
web/coverage/
# Vite build output. Only the empty .gitkeep is tracked so `//go:embed all:dist`
# compiles on a fresh clone without building the UI (vite.config.ts restores it
# after emptying the directory).
web/dist/*
!web/dist/.gitkeep
